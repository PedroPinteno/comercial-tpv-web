---
import AppShell from "@/layouts/AppShell.astro";
import SearchClient from "@/components/SearchClient";
---

<AppShell title="TPV · Búsqueda">
  <header>
    <a href="/app">← Categorías</a>
    <div><button id="logout" class="btn">Salir</button></div>
  </header>

  <div class="container">
    <div class="search">
      <input id="q" type="search" placeholder="Buscar…" />
      <button id="btnSearch" class="btn">Buscar</button>
    </div>

    <div id="results" class="list"></div>
    <div id="error" class="hidden"></div>
  </div>

  <SearchClient client:load />
</AppShell>

<style>
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; background:#f9fafb; margin:0; }
  header { display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:#fff; border-bottom:1px solid #e5e7eb; }
  .container { max-width: 1024px; margin: 0 auto; padding: 16px; }
  .search { display:flex; gap:8px; margin-bottom:16px; }
  input[type="search"], input[type="number"], select { padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px; }
  input[type="search"] { flex:1; }
  .btn { border:1px solid #e5e7eb; background:#fff; padding:8px 12px; border-radius:8px; cursor:pointer; }
  .list { background:#fff; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden; }
  .row { display:grid; grid-template-columns: 1.2fr 2fr 0.8fr 0.3fr; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid #f3f4f6; }
  .row:last-child { border-bottom:none; }
  .row h4 { margin:0; font-size:14px; }
  .muted { color:#6b7280; font-size:12px; }
  .calc { display:flex; gap:8px; align-items:center; }
  .price { margin-top:12px; padding:12px; background:#ecfeff; border:1px solid #a5f3fc; border-radius:8px; }
  .hidden { display:none; }
  a { color:#2563eb; text-decoration:none; }
</style>
