---
import AppShell from "@/layouts/AppShell.astro";
import SearchClient from "@/components/SearchClient";
---

<AppShell title="TPV · Búsqueda" showSearch={false}>
  <div class="page-head">
    <a href="/app" class="link-back">← Categorías</a>
  </div>

  <div class="container">
    <div id="selectedCategory" class="selected-category hidden"></div>
    <div class="search">
      <input id="q" type="search" placeholder="Buscar…" />
      <button id="btnSearch" class="btn">Buscar</button>
    </div>

    <div id="results" class="list"></div>
    <div id="error" class="hidden"></div>
  </div>

  <SearchClient client:load />
</AppShell>

<style>
  .page-head {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 8px 0 12px;
  }
  .link-back {
    color: var(--color-primary, #2563eb);
    text-decoration: none;
    font-weight: 600;
  }
  .container {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 0 16px;
  }
  .selected-category {
    font-weight: 700;
    color: var(--color-text, #111827);
    margin-bottom: 12px;
  }
  .search { display:flex; gap:8px; margin-bottom:16px; }
  .search { transform-origin: 100% 50%; }
  .search.reveal-search { animation: revealSearch 320ms ease-out; }
  @keyframes revealSearch {
    from { transform: scaleX(0.2); opacity: 0; }
    to { transform: scaleX(1); opacity: 1; }
  }
  input[type="search"], input[type="number"], select { padding:10px 12px; border:1px solid var(--color-border, #e5e7eb); border-radius:8px; }
  input[type="search"] { flex:1; }
  .btn { border:1px solid var(--color-border, #e5e7eb); background:var(--color-bg-card, #fff); padding:8px 12px; border-radius:8px; cursor:pointer; }
  .list { background:var(--color-bg-card, #fff); border:1px solid var(--color-border, #e5e7eb); border-radius:12px; overflow:hidden; }
  .list.bag-mode { border: none; background: transparent; overflow: visible; padding: 0; }
  .row { display:grid; grid-template-columns: 1.2fr 2fr 0.8fr 0.3fr; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid #f3f4f6; }
  .row:last-child { border-bottom:none; }
  .row h4 { margin:0; font-size:14px; }
  .muted { color:var(--color-text-light, #6b7280); font-size:12px; }
  .calc { display:flex; gap:8px; align-items:center; }
  .price { margin-top:12px; padding:12px; background:#ecfeff; border:1px solid #a5f3fc; border-radius:8px; }
  .hidden { display:none; }
  :global(.bag-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  :global(.bag-card) {
    border: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-bg-card, #fff);
    border-radius: 12px;
    padding: 24px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
  :global(.bag-card:hover) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.1));
  }
  @media (max-width: 768px) {
    .row { grid-template-columns: 1fr; gap:6px; }
    .calc { justify-content: flex-start; }
  }
</style>
