---
import { supabase } from "@/lib/supabaseClient";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login · Comercial TPV</title>
    <style>
      body {
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        background:#f9fafb;
        margin:0;
        display:grid;
        place-items:center;
        min-height:100vh;
      }
      .card {
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:12px;
        padding:24px;
        width:100%;
        max-width:360px;
        box-shadow:0 2px 12px rgba(0,0,0,0.04);
      }
      h1 { font-size:18px; margin:0 0 16px; }
      label { display:block; font-size:13px; margin:12px 0 6px; }
      input {
        width:100%;
        padding:10px 12px;
        border:1px solid #e5e7eb;
        border-radius:8px;
        font-size:14px;
      }
      button {
        margin-top:16px;
        width:100%;
        padding:10px 12px;
        background:#111827;
        color:#fff;
        border:none;
        border-radius:8px;
        cursor:pointer;
      }
      .error {
        color:#b91c1c;
        font-size:13px;
        margin-top:8px;
      }
    </style>
  </head>
  <body>
    <form class="card" id="login-form" method="post">
      <h1>Acceder</h1>

      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />

      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" required />

      <button id="btn" type="submit">Entrar</button>
      <p id="error" class="error" aria-live="polite"></p>
    </form>

    <script type="module">
      import { supabase } from "/src/lib/supabaseClient.ts";
      // Para depuración desde la consola del navegador
      // @ts-ignore
      window.supabase = supabase;

      const form = document.getElementById("login-form");
      const errorEl = document.getElementById("error");
      const btn = document.getElementById("btn");

      // Redirige si ya hay sesión cargada
      (async () => {
        const { data } = await supabase.auth.getSession();
        if (data.session) window.location.href = "/app";
      })();

      // Redirige cuando el SDK confirma sesión (evita condiciones de carrera)
      supabase.auth.onAuthStateChange((_event, session) => {
        if (session) window.location.href = "/app";
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.textContent = "";
        btn.disabled = true;
        try {
          const fd = new FormData(form);
          const email = String(fd.get("email") || "");
          const password = String(fd.get("password") || "");
          const { error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) errorEl.textContent = "Error de login: " + error.message;
          // La redirección la realizará onAuthStateChange cuando exista sesión
        } catch {
          errorEl.textContent = "No se pudo conectar. Revisa tu red.";
        } finally {
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>

