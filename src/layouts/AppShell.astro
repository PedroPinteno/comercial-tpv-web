---
import CompanyBar from "@/components/layout/CompanyBar.astro";
import HeaderBar from "@/components/layout/HeaderBar.astro";

const { title = "TPV" } = Astro.props as { title?: string };
---

<div class="page" aria-label={title}>
  <div class="main-container">
    <CompanyBar />
    <HeaderBar />
    <div class="container">
      <slot />
    </div>
  </div>
</div>

<style>
  .page {
    display: flex;
    justify-content: center;
  }

  .main-container {
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
    box-shadow: 0 0 15px rgba(0,0,0,0.1);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 16px;
    min-height: calc(100vh - 140px);
    border-radius: 0 0 8px 8px;
  }
</style>
