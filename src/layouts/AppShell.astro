---
import CompanyBar from "@/components/layout/CompanyBar.astro";
import HeaderBar from "@/components/layout/HeaderBar.astro";
import "@/styles/theme.css";

interface Props {
  title?: string;
  showBars?: boolean;
}

const { title = "Comercial TPV", showBars = true } = Astro.props as Props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-root">
      {showBars && (
        <>
          <CompanyBar />
          <HeaderBar />
        </>
      )}

      <main class="app-main">
        <slot />
      </main>
    </div>
  </body>
</html>
