---
import CompanyBar from "@/components/layout/CompanyBar.astro";
import HeaderBar from "@/components/layout/HeaderBar.astro";
import "@/styles/theme.css";

interface Props {
  title?: string;
  showBars?: boolean;
  showSearch?: boolean;
}

const { title = "Comercial TPV", showBars = true, showSearch = true } = Astro.props as Props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-root">
      {showBars && (
        <>
          <CompanyBar />
          <HeaderBar showSearch={showSearch} />
        </>
      )}

      <main class="app-main">
        <slot />
      </main>
    </div>
    <style>
      :global(body) {
        margin: 0;
        background: var(--color-bg-page, #f9fafb);
        font-family: var(--font-sans, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif);
      }
      .app-root {
        min-height: 100vh;
      }
      .app-main {
        width: min(1100px, 80vw);
        margin: 0 auto;
        padding: 16px;
        box-sizing: border-box;
      }
      @media (max-width: 768px) {
        .app-main {
          padding: 12px;
          max-width: 100%;
        }
      }
    </style>
  </body>
</html>
